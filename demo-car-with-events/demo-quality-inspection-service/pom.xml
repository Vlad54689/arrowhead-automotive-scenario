<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>eu.arrowhead</groupId>
		<artifactId>demo-car-with-events</artifactId>
		<version>4.4.0.2</version>
	</parent>

	<artifactId>demo-quality-inspection-service</artifactId>
	<name>Arrowhead Demo Quality Inspection Service</name>

	<dependencies>
		<!--
			The Arrowhead client libraries (ai.aitia:arrowhead-application-library-java-spring,
			which transitively provides eu.arrowhead:arrowhead-common) are inherited from the
			grandparent "demo" pom (root pom.xml, version 4.4.0.2) - exactly the same way the
			reference module demo-car-provider-with-publishing obtains them. The only explicit
			dependency the reference module declares is the common module below.
		-->
		<dependency>
			<groupId>eu.arrowhead</groupId>
			<artifactId>demo-car-with-events-common</artifactId>
			<version>4.4.0.2</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>repackage</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>copy-resources</id>
						<phase>validate</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${basedir}/target</outputDirectory>
							<resources>
								<resource>
									<directory>src/main/resources</directory>
									<includes>
										<include>application.properties</include>
									</includes>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
